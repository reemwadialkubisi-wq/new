# Reem's time zone, used to decide what "today" is.
APP_TIMEZONE=Asia/Riyadh

# Supabase (Project Settings → API). Leave empty to run in local preview mode (no login).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only this email can sign in (single-user app).
ALLOWED_EMAIL=
# Postgres connection string for Drizzle migrations (Project Settings → Database).
DATABASE_URL=
