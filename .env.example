# Nothing is required to run locally. Copy to .env.local only to change a default.

# Reem's time zone for a brand-new database (after that it is edited in Settings).
APP_TIMEZONE=Asia/Riyadh

# Where the local database lives. Default: data/reem.db inside the app folder.
# DATABASE_PATH=

# Optional, not used locally: Supabase sign-in for a future online version.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ALLOWED_EMAIL=
